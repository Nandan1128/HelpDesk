# ==============================================================================
# TicketAI Production Environment Variables Template (Backend / Railway)
# ==============================================================================

NODE_ENV=production
PORT=5000

# PostgreSQL (Auto-provided on Railway if linked to Postgres service)
DATABASE_URL="postgresql://postgres:password@postgres.railway.internal:5432/railway?schema=public"

# Better Auth Secret (Generate via `openssl rand -base64 32`)
BETTER_AUTH_SECRET="CHANGE_ME_GENERATE_32_CHAR_RANDOM_SECRET_KEY_HERE"
BETTER_AUTH_URL="https://${{RAILWAY_PUBLIC_DOMAIN}}"
FRONTEND_URL="https://${{RAILWAY_PUBLIC_DOMAIN}}"
TRUSTED_ORIGINS="https://${{RAILWAY_PUBLIC_DOMAIN}}"

# Initial Admin Credentials (Created automatically on first launch)
ADMIN_EMAIL="admin@ticketai.com"
ADMIN_PASSWORD="CHANGE_ME_SUPER_STRONG_PASSWORD_123!"
ADMIN_NAME="System Administrator"

# Google Gemini AI Key
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.5-flash"

# Email Configuration
EMAIL_PROVIDER="mock"
EMAIL_USER="support@yourcompany.com"
EMAIL_PASS=""
SUPPORT_EMAIL="support@yourcompany.com"

# IMAP Inbound Ingestion (Optional)
IMAP_ENABLED=false
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_SECURE=true
IMAP_POLL_INTERVAL_SEC=30

# Sentry Monitoring (Optional)
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.2
