{
  "name": "ai-ticket-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:test": "bun --env-file=.env.test --watch src/index.ts",
    "test": "bun test",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun dist/index.js",
    "start:test": "bun --env-file=.env.test dist/index.js",
    "db:migrate": "bun x prisma migrate dev",
    "db:generate": "bun x prisma generate",
    "db:seed": "bun prisma/seed.ts",
    "seed:ai": "bun prisma/seed-ai-agent.ts",
    "db:studio": "bun x prisma studio",
    "db:push": "bun x prisma db push",
    "db:test:setup": "bun scripts/setup-test-db.ts",
    "db:test:reset": "bun scripts/setup-test-db.ts --reset",
    "db:test:seed": "bun scripts/setup-test-db.ts --seed",
    "email:test": "bun scripts/test-email.ts",
    "email:poll": "bun scripts/poll-emails.ts"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.64",
    "@google/genai": "^2.19.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.74.0",
    "ai": "^7.0.93",
    "better-auth": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.1",
    "pg-boss": "^12.30.0",
    "zod": "^3.24.1",
    "@ticket-system/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "prisma": "^5.22.0",
    "typescript": "^5.7.2"
  }
}
