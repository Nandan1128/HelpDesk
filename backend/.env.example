# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/helpdesk?schema=public"

# Better Auth Configuration (random 32+ char secret)
BETTER_AUTH_SECRET="your-super-secret-auth-key-change-in-production-min32chars"
BETTER_AUTH_URL="http://localhost:5000"

# Session Secret (Legacy/Fallback)
SESSION_SECRET="your-super-secret-session-key-change-in-production-min32chars"

# Google Gemini API Key
GEMINI_API_KEY="your-gemini-api-key-here"

# Email Provider Configuration (SendGrid or Mailgun)
EMAIL_PROVIDER="mock" # Options: "mock", "sendgrid", "mailgun"
SENDGRID_API_KEY=""
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
SUPPORT_EMAIL="support@ticketai.local"

# Initial Seed Admin User
ADMIN_EMAIL="admin@ticketai.local"
ADMIN_PASSWORD="AdminPassword123!"
ADMIN_NAME="System Administrator"
