# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
TRUSTED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000"

# Database Connection (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/helpdesk?schema=public"

# Better Auth Configuration (random 32+ char secret)
BETTER_AUTH_SECRET="your-super-secret-auth-key-change-in-production-min32chars"
BETTER_AUTH_URL="http://localhost:5000"

# Session Secret (Legacy/Fallback)
SESSION_SECRET="your-super-secret-session-key-change-in-production-min32chars"

# Google Gemini API Key
GEMINI_API_KEY="your-gemini-api-key-here"

# Email Provider Configuration (Gmail SMTP, Custom SMTP, SendGrid, or Mock)
EMAIL_PROVIDER="gmail" # Options: "gmail", "smtp", "sendgrid", "mailgun", "mock"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-16-char-app-password" # Generated from Google Account Security > App Passwords
# Inbound IMAP Polling (Automatic Ticket Creation from Incoming Gmail Emails)
IMAP_ENABLED=true
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_SECURE=true
IMAP_POLL_INTERVAL_SEC=30

SUPPORT_EMAIL="nandanpatel0198@gmail.com"

# Initial Seed Admin User
ADMIN_EMAIL="admin@ticketai.local"
ADMIN_PASSWORD="AdminPassword123!"
ADMIN_NAME="System Administrator"
