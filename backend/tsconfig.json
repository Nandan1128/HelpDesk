{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@core": ["../core/src/index.ts"],
      "@core/*": ["../core/src/*"],
      "@ticket-system/core": ["../core/src/index.ts"],
      "@ticket-system/core/*": ["../core/src/*"]
    },
    "outDir": "dist"
  },
  "include": ["src/**/*", "prisma/**/*", "../core/src/**/*"]
}
