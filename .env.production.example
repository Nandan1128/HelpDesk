# ==============================================================================
# TicketAI Production Environment Variables Template (Railway)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
# Railway automatically assigns PORT, but default 5000 is used as fallback
PORT=5000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# In Railway: If PostgreSQL is added to your project, link it to this service
# or use: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:password@postgres.railway.internal:5432/railway?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Better Auth)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32 (Must be 32+ characters)
BETTER_AUTH_SECRET="CHANGE_ME_GENERATE_32_CHAR_RANDOM_SECRET_KEY_HERE"

# The public base URL of the deployment (Include https://)
# On Railway, you can use: https://${{RAILWAY_PUBLIC_DOMAIN}}
BETTER_AUTH_URL="https://${{RAILWAY_PUBLIC_DOMAIN}}"

# Frontend URL
FRONTEND_URL="https://${{RAILWAY_PUBLIC_DOMAIN}}"

# Comma-separated allowed CORS & Auth origins (NO trailing slashes)
# In unified single-container mode: include the Railway public domain and custom domain
TRUSTED_ORIGINS="https://${{RAILWAY_PUBLIC_DOMAIN}}"

# ------------------------------------------------------------------------------
# 4. INITIAL SYSTEM ADMINISTRATOR SEED
# ------------------------------------------------------------------------------
# Automatically created on first deployment if no users exist in the database
ADMIN_EMAIL="admin@ticketai.com"
ADMIN_PASSWORD="CHANGE_ME_SUPER_STRONG_PASSWORD_123!"
ADMIN_NAME="System Administrator"

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Get your API Key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 6. INBOUND & OUTBOUND EMAIL CONFIGURATION (Optional / Recommended)
# ------------------------------------------------------------------------------
# Provider options: "gmail", "smtp", "sendgrid", "mailgun", "mock"
EMAIL_PROVIDER="mock"
EMAIL_USER="support@yourcompany.com"
EMAIL_PASS=""
SUPPORT_EMAIL="support@yourcompany.com"

# Custom SMTP (if EMAIL_PROVIDER="smtp")
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_SECURE=false

# Inbound Email IMAP Listener (Auto-converts incoming emails to tickets)
IMAP_ENABLED=false
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_SECURE=true
IMAP_POLL_INTERVAL_SEC=30

# SendGrid / Mailgun API keys (if applicable)
SENDGRID_API_KEY=""
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""

# ------------------------------------------------------------------------------
# 7. SENTRY ERROR TRACKING & PERFORMANCE MONITORING (Optional)
# ------------------------------------------------------------------------------
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.2
