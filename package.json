{
  "name": "ai-ticket-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-Powered Ticket Management System with Express, React, TypeScript, Bun, Prisma, PostgreSQL, and Google Gemini",
  "scripts": {
    "dev": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
    "dev:backend": "cd backend && bun run dev",
    "dev:frontend": "cd frontend && bun run dev",
    "build": "bun run build:backend && bun run build:frontend",
    "build:backend": "cd backend && bun run build",
    "build:frontend": "cd frontend && bun run build",
    "db:migrate": "cd backend && bun run db:migrate",
    "db:generate": "cd backend && bun run db:generate",
    "db:seed": "cd backend && bun run db:seed",
    "db:studio": "cd backend && bun run db:studio",
    "db:test:setup": "cd backend && bun run db:test:setup",
    "db:test:reset": "cd backend && bun run db:test:reset",
    "db:test:seed": "cd backend && bun run db:test:seed",
    "test:frontend": "cd frontend && bun run test",
    "test:backend": "cd backend && bun run test",
    "test:e2e": "bun run db:test:setup && playwright test",
    "test:e2e:ui": "bun run db:test:setup && playwright test --ui",
    "test:e2e:debug": "bun run db:test:setup && playwright test --debug",
    "test:e2e:report": "playwright show-report e2e/playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@prisma/client": "5.22.0",
    "@types/node": "^26.4.0",
    "better-auth": "^1.7.2",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "prisma": "5.22.0"
  }
}
